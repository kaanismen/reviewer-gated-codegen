# Bu dosyayı ".env" olarak kopyalayın ve kullanacağınız sağlayıcının
# anahtarını doldurun. .env YOKSA da sistem çalışır: replay sağlayıcısıyla
# açılır ve kayıtlı senaryoları oynatır.
#
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)

# anthropic | openai | ollama | replay
# Boş bırakılırsa: anahtar varsa anthropic, yoksa replay seçilir.
LLM_PROVIDER=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama host makinede çalışıyorsa bu adres konteynerden erişilebilir.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Host'ta hangi porta yayınlansın
WEB_PORT=8000

# --- Kontrol limitleri (PROJECT.md §5) — boş bırakılırsa varsayılan kullanılır
# MAX_TUR=5
# MAX_TOKEN_TOPLAM=150000
# MAX_MALIYET_USD=1.00
# MAX_SURE_SN=300
# SANDBOX_TIMEOUT_SN=30
