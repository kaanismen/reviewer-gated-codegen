# Copy this file to ".env" and fill in the key for the provider you intend to
# use. The system also runs WITHOUT a .env: it falls back to the "replay"
# provider and plays back recorded cassettes.
#
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)

# anthropic | openai | ollama | replay
# If left empty: anthropic when a key is present, otherwise replay.
LLM_PROVIDER=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Reachable from inside the container when Ollama runs on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Host port the web interface is published on.
WEB_PORT=8000

# --- Control limits. Leave commented out to use the defaults shown.
# MAX_TUR=5                 # max turns per task
# MAX_TOKEN_TOPLAM=150000   # max total tokens per task
# MAX_MALIYET_USD=1.00      # max spend per task, USD
# MAX_SURE_SN=300           # max wall-clock seconds per task
# MAX_GOREV_KARAKTER=2000   # max characters accepted in a task prompt
# SANDBOX_TIMEOUT_SN=30     # wall-clock ceiling for one sandboxed test run
